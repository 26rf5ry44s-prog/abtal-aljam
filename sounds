Import os
import asyncio
import edge_tts

# إنشاء مجلد sounds تلقائياً
os.makedirs("sounds", exist_ok=True)

phrases = [
    "يا سلام عليك يا شطورة!",
    "كفو والله، جبتيها صح!",
    "الله عليك يا بطلة، وش هالشطارة!",
    "عفية عليك يا قمر، يلا نكمل!",
    "ما شاء الله عليك، كل مرة تصيرين أشطر!",
    "حاولي مرة ثانية، إنتِ قدها، والخطأ بداية النجاح."
]

async def generate():
    print("جاري توليد أصوات المعلمة...")
    for i, text in enumerate(phrases, start=1):
        tts = edge_tts.Communicate(
            text=text,
            voice="ar-SA-ZariyahNeural"
        )
        file_path = os.path.join("sounds", f"voice_{i}.mp3")
        await tts.save(file_path)
        print(f"تم حفظ: {file_path}")
    print("\nتم الانتهاء بنجاح! يمكنك الآن فتح ملف index.html والبدء باللعب.")

if __name__ == "__main__":
    asyncio.run(generate())
